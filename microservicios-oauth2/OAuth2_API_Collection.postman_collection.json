	},
	"item": [
		{
			"name": "Autenticación",
			"item": [
				{
					"name": "Obtener token (password grant)",
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "password",
									"value": "123456",
									"type": "string"
								},
								{
									"key": "username",
									"value": "gateway-client",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "grant_type",
									"value": "password",
									"type": "text"
								},
								{
									"key": "username",
									"value": "admin",
									"type": "text"
								},
								{
									"key": "password",
									"value": "123456",
									"type": "text"
								},
								{
									"key": "scope",
									"value": "read write",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/oauth2/password-token",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"oauth2",
								"password-token"
							]
						},
						"description": "Obtiene un token de acceso utilizando el flujo password grant type. Requiere autenticación básica del cliente OAuth2 y las credenciales del usuario."
					},
					"response": []
				},
				{
					"name": "Obtener token (client credentials)",
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "password",
									"value": "123456",
									"type": "string"
								},
								{
									"key": "username",
									"value": "gateway-client",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "grant_type",
									"value": "client_credentials",
									"type": "text"
								},
								{
									"key": "scope",
									"value": "read write",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/oauth2/token",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"oauth2",
								"token"
							]
						},
						"description": "Obtiene un token de acceso utilizando el flujo client credentials. Requiere autenticación básica del cliente OAuth2."
					},
					"response": []
				},
				{
					"name": "Refrescar token",
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "password",
									"value": "123456",
									"type": "string"
								},
								{
									"key": "username",
									"value": "gateway-client",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "grant_type",
									"value": "refresh_token",
									"type": "text"
								},
								{
									"key": "refresh_token",
									"value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
									"type": "text",
									"description": "Reemplazar con un refresh_token válido"
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/oauth2/token",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"oauth2",
								"token"
							]
						},
						"description": "Refresca un token de acceso expirado utilizando un refresh_token válido."
					},
					"response": []
				}
			],
			"description": "Endpoints para autenticación y obtención de tokens"
		},
		{
			"name": "Información de Usuario",
			"item": [
				{
					"name": "Obtener información del usuario actual",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
									"type": "string",
									"description": "Reemplazar con un access_token válido"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/oauth2/user-info",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"oauth2",
								"user-info"
							]
						},
						"description": "Obtiene información del usuario autenticado con el token proporcionado."
					},
					"response": []
				}
			],
			"description": "Endpoints para obtener información de usuario"
		},
