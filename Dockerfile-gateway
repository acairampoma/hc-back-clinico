# 🚪 DOCKERFILE GATEWAY EN ROOT - RAILWAY COMPATIBLE
# Ubicación: /Dockerfile-gateway (en la raíz de hc-back-clinico)

# ============================================
# STAGE 1: BUILD Gateway en Monorepo
# ============================================
FROM eclipse-temurin:11-jdk-alpine AS builder

# Instalar Maven
RUN apk add --no-cache maven

# Crear directorio de trabajo
WORKDIR /app

# Copiar pom.xml del microservicio Gateway
COPY microservicios-gateway/pom.xml ./pom.xml

# Descargar dependencias (layer cacheado)
RUN mvn dependency:go-offline -B

# Copiar código fuente de Gateway
COPY microservicios-gateway/src ./src

# Compilar específicamente Gateway
RUN mvn clean package -DskipTests -Dspring.profiles.active=railway

# ============================================
# STAGE 2: RUNTIME
# ============================================
FROM eclipse-temurin:11-jre-alpine

# Metadatos
LABEL maintainer="Alan Cairampoma <cumpa@hospital.pe>"
LABEL description="API Gateway - Sistema Hospitalario"

# Crear usuario no-root
RUN addgroup -g 1001 -S gateway && \
    adduser -S gateway -u 1001 -G gateway

# Directorio de trabajo
WORKDIR /app

# Copiar JAR compilado desde stage anterior
COPY --from=builder /app/target/*.jar app.jar

# Cambiar ownership
RUN chown gateway:gateway app.jar

# Usuario no-root
USER gateway

# Puerto Gateway
EXPOSE 8090

# Variables de entorno
ENV JAVA_OPTS="-Xms256m -Xmx512m -XX:+UseG1GC" \
    SPRING_PROFILES_ACTIVE=railway \
    SERVER_PORT=8090

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8090/actuator/health || exit 1

# Comando de inicio
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]

# ============================================
# INSTRUCCIONES:
# 1. Guardar como "Dockerfile-gateway" en root de hc-back-clinico
# 2. Railway: New Service → "API Gateway"
# 3. Root Directory: /
# 4. Custom Build Command: docker build -f Dockerfile-gateway -t gateway .
# ============================================